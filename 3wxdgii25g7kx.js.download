    query ugcArticleSolutionArticlesWithUuids($articleUuids: [String]!, $skip: Int, $before: String, $after: String, $first: Int, $last: Int) {
  ugcArticleSolutionArticlesWithUuids(
    articleUuids: $articleUuids
    skip: $skip
    before: $before
    after: $after
    first: $first
    last: $last
  ) {
    totalNum
    pageInfo {
      hasNextPage
    }
    edges {
      node {
        uuid
        title
        slug
        summary
        author {
          realName
          userAvatar
          userSlug
          userName
          nameColor
          certificationLevel
          activeBadge {
            icon
            displayName
          }
        }
        articleType
        thumbnail
        createdAt
        updatedAt
        status
        isLeetcode
        canSee
        canEdit
        isMyFavorite
        chargeType
        myReactionType
        topicId
        hitCount
        hasVideoArticle
        reactions {
          count
          reactionType
        }
        tags {
          name
          slug
          tagType
        }
        topic {
          id
          topLevelCommentCount
        }
      }
    }
  }
}
